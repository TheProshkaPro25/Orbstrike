      "page": "https://vroid.com/en/news/13wYERzQUdLccdo9DtRcVx",
      "license_url": "https://vroid.com/en/studio/guidelines",
      "release_notes": "https://vroid.com/en/studio/notice/2lvOGDTYM1AnvXKxbgJoQi",
      "studio": "VRoid Studio 2.16.0. Default masculine avatar, original preset hair color and textures. VRM 0.0 export without mesh or texture reduction or material merging.",
      "identification": "Seven Overall Hair presets, one Back preset and two Tied presets were added between the bundled Studio 1.18.0 and 1.19.0 thumbnail catalogs. Matched to the ten silhouettes in the pixiv announcement.",
      "preparation": "Stage each donor with tools/avatars/stage_booth_vrm.py and import it in Godot. Run tools/avatars/fit_studio_hair.gd with the imported VRM path and the destination stem. Hair and HairBack scalp are fitted in head-local metres. The static parts retain UVs and MToon dye support. Identical materials are stored once for both bases.",
      "materials": [
        {
          "file": "clct_gear_material_5ae73c0774d1eaaa532dfb50.res",
          "sha256": "c37f1c38e29f4ed344905cd85da8bcb301e27c9b54d8009a60d7e37849de6478"
        },
        {
          "file": "clct_gear_material_971e33760db032ba63e60bd5.res",
          "sha256": "1a03efde3b02c2b6103992a4929837cd60c851a2d8727ed096eb5a2a5f7f3a98"
        }
      ],
      "fitting": "tools/avatars/fit_gear_hair.gd fits the rear scalp and short strands of presets AllHair 248, Tied 622 and Tied 623 to Vita’s nape. The Sakurada Tactical Jacket embeds its own Tied 623 mesh with the four long strands curved over the padded hood."
    }
  }
