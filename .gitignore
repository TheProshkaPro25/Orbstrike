# Kevin Iglesias animations: licensed local installation, no raw redistribution.
assets/avatars/motions/kevin_local/

# Prepared itch.io textures used by the character editor (licensed game assets).
!assets/avatars/itch/**/*.png

# Character editor runtime catalog textures.
!assets/avatars/editor/catalog_*.png

# Author audio previews remain local; only the selected canonical cue is shipped.
assets/audio/candidates/*
!assets/audio/candidates/.gdignore

# Runtime portraits rendered from creature models.
!assets/portraits/creatures/*.png

# Illustrated Harbor runtime atlases, reproducible with tools/art/paint_illustrated_harbor.py.
