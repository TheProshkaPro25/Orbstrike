[Unit]
Description=Orbstrike authoritative online match server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=orbstrike-online
Group=orbstrike-online
WorkingDirectory=/opt/orbstrike-online/current
ExecStart=/opt/orbstrike-online/current/deploy/start_server.sh
Environment=GODOT=/opt/orbstrike-online/godot
Environment=ORBSTRIKE_SERVER_ROOT=/opt/orbstrike-online/current
Environment=ORBSTRIKE_STATE_DIR=/var/lib/orbstrike-online
Environment=XDG_DATA_HOME=/var/lib/orbstrike-online/data
Environment=XDG_CONFIG_HOME=/var/lib/orbstrike-online/config
Environment=XDG_CACHE_HOME=/var/lib/orbstrike-online/cache
StateDirectory=orbstrike-online
StateDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orbstrike-online
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictRealtime=true
LimitNOFILE=256
TasksMax=128
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
