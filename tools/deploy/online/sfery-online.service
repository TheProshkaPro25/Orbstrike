[Unit]
Description=Sfery Stikhiy authoritative online match server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sfery-online
Group=sfery-online
WorkingDirectory=/opt/sfery-online/current
ExecStart=/opt/sfery-online/current/deploy/start_server.sh
Environment=GODOT=/opt/sfery-online/godot
Environment=SFERY_SERVER_ROOT=/opt/sfery-online/current
Environment=SFERY_STATE_DIR=/var/lib/sfery-online
Environment=XDG_DATA_HOME=/var/lib/sfery-online/data
Environment=XDG_CONFIG_HOME=/var/lib/sfery-online/config
Environment=XDG_CACHE_HOME=/var/lib/sfery-online/cache
StateDirectory=sfery-online
StateDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sfery-online
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictRealtime=true
LimitNOFILE=256
TasksMax=128
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
